{
  "expo": {
    "name": "Watfa",
    "slug": "watfa-super-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "experiments": {
      "baseUrl": "/watfa-super-app"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yazoniplay.watfa"
    },
    "android": {
      "package": "com.yazoniplay.watfa",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Watfa to take a photo for hairstyle planning.",
          "photosPermission": "Allow Watfa to select a hairstyle reference photo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
